                          "fill": "$brand-ink-soft",
                          "content": "OBSERVER · BRAND STUDY, SET D",
                          "fontFamily": "$font-mono",
                          "fontSize": 9,
                          "fontWeight": "500",
                          "letterSpacing": 1.2
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "aMpCW",
                      "name": "Note columns",
                      "width": "fill_container",
                      "gap": 24,
                      "children": [
                        {
                          "type": "text",
                          "id": "vtctm",
                          "name": "Note · habitat",
                          "fill": "$brand-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Flat ground only. Prefers one uninterrupted field of colour — no gradient, no shadow, no photograph beneath. Holds the tuck wherever the leader's draft stays legible, that is, wherever both figures read in file at one scale. Where the draft cannot be shown, the species does not occur and the ground goes to the upright form instead.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-body",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "CDSV8",
                          "name": "Note · status",
                          "fill": "$brand-ink-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Operator aerodynamicus tuckus is resident on product ground through all twelve months and does not vacate it. Agens ducens leads on both seasonal passes and is scarce between them. The skein is not recorded below 24 px, where the gap between the two closes and the tuck is lost. Records on team issue remain accidental.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-body",
                          "fontSize": 11.5,
                          "fontWeight": "normal",
                          "fontStyle": "italic"
                        }
                      ]
                    }
                  ]
                },
