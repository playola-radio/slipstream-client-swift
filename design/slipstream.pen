                  "name": "Plate caption",
                  "fill": "$brand-ink-soft",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "PLATE 2.—Adult, in tuck, at speed; leading agent shown at the same scale. Note the flat back and the head carried below the shoulder. These two marks identify the species at any distance and in any colour.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
