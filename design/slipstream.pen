                    {
                      "type": "frame",
                      "id": "nD0A0",
                      "name": "Task 2 chronological group",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 24,
                      "children": [
                        {
                          "type": "frame",
                          "id": "kBegr",
                          "name": "Task 2 sticky heading",
                          "metadata": {
                            "type": "interaction",
                            "behavior": "Shown inline in chronology. Replaces Task 1 at the feed's sticky boundary."
                          },
                          "width": "fill_container",
                          "fill": "#24313B",
                          "stroke": "#526B7B",
                          "strokeWidth": {
                            "bottom": 1
                          },
                          "layout": "vertical",
                          "gap": 8,
                          "padding": [
                            12,
                            20
                          ],
