                          "fill": "$brand-ink-soft",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Recorded alone, without a lead. The tuck is kept — posture is habit, not response — but nothing ahead is moving the air: the saving is nil and the bird pays station-one prices for its own wind. Not to be taken for Operator aerodynamicus erectus, which stands upright and has never held station.",
                          "lineHeight": 1.55,
                          "fontFamily": "$font-body",
                          "fontSize": 12,
                          "fontWeight": "normal",
                          "fontStyle": "italic"
                        }
