          "children": [
            {
              "type": "text",
              "id": "BK79s",
              "name": "Guide line",
              "fill": "$brand-ink-soft",
              "content": "A FIELD GUIDE TO THE SLIPSTREAM  ·  SET D",
              "fontFamily": "$font-mono",
              "fontSize": 15,
              "fontWeight": "500",
              "letterSpacing": 2
            },
            {
              "type": "text",
              "id": "Gnai3",
              "name": "Source note",
              "fill": "$brand-ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Identification design after the Peterson Field Guide system, 1934 onward: comparative silhouettes held at one scale and one posture, pointer lines aimed at a single diagnostic field mark, flight-silhouette endpapers for recognition at distance, keyed range maps, and clipped field-note voice. Formation behaviour after the aerodynamics of skein flight.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "t3fAr",
              "name": "Nomenclature note",
              "fill": "$brand-ink-soft",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Nomenclature used throughout: Operator aerodynamicus tuckus, the tucked operator (primary mark) · Operator aerodynamicus erectus, the upright operator (control) · Agens ducens, the leading agent · the pair in file, the skein.",
              "lineHeight": 1.5,
              "fontFamily": "$font-body",
              "fontSize": 13,
              "fontWeight": "normal",
              "fontStyle": "italic"
            }
          ]
