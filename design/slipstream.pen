                              "name": "Heading",
                              "fill": "$brand-ink",
                              "content": "VOICE",
                              "fontFamily": "$font-mono",
                              "fontSize": 10,
                              "fontWeight": "500",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
