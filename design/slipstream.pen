                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            {
                              "type": "text",
                              "id": "AgNxf",
                              "name": "Heading",
                              "fill": "$brand-ink",
                              "content": "FIELD MARKS",
                              "fontFamily": "$font-mono",
                              "fontSize": 10,
                              "fontWeight": "500",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "Ve27n",
                              "name": "Body",
                              "fill": "$brand-ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Back flat and level with the deck; no daylight between shoulder and hip. Head carried below the shoulder line. Hands remain on the keys through the whole pass. Holds one body length off the leader — closer and it fouls, further and it loses the wake.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font-body",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "e7cXf",
                          "name": "Section SIMILAR SPECIES",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            {
                              "type": "text",
                              "id": "RJimC",
                              "name": "Heading",
                              "fill": "$brand-ink",
                              "content": "SIMILAR SPECIES",
                              "fontFamily": "$font-mono",
                              "fontSize": 10,
                              "fontWeight": "500",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "m6Ckpd",
                              "name": "Body",
                              "fill": "$brand-ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "O. a. erectus sits bolt upright and is told at any distance. Birds flying abreast are a different animal: they fuse to a single blot below 24 px. See Plate 3.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font-body",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
