                              "name": "Body",
                              "fill": "$brand-ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A low continuous key-clatter, rarely broken. Does not announce itself. Silent while drafting; one soft note on completion.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font-body",
                              "fontSize": 12.5,
