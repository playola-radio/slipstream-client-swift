                    {
                      "type": "text",
                      "id": "Sq5X6",
                      "name": "Range verdict",
                      "fill": "$brand-ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "At × 0.17 two silhouettes still name themselves: 1, the arch of the tuck, and 4, the leader with a gap behind it. Figures 6 and 8 fail first — the tight skein merges into one heavy body, the double lead loses its operator altogether. Identify by the pair, then by the arch.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-body",
                      "fontSize": 10.5,
                      "fontWeight": "normal"
                    }
                  ]
                },
