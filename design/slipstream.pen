                              "fontWeight": "normal",
                              "letterSpacing": 0.9
                            },
                            {
                              "type": "frame",
                              "id": "f1JBCM",
                              "name": "[0007]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "h5ziI",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0007]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "gd2K0",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "FIG. 1 is a side elevational view of the mark (10), showing the operator (12) tucked in the wake (24) of the agent (22).",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "qQixh",
                              "name": "[0008]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "YByyY",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0008]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "n8UtRr",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "FIG. 2 is a plan view of the mark (10), showing the gap (26) of one body length maintained in single file.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "rGxTQ",
                              "name": "[0009]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "rfG19",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0009]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "q6gs7Y",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "FIG. 3 is a side elevational view of the mark (10) in combination with the wordmark (28) and the ground line (30).",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "yhhaQ",
                              "name": "[0010]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "VN7qH",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0010]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "Kv3eM",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "FIG. 4 is an enlarged side elevational view of the mark (10), showing the flow indicia (32) in single-ink reproduction.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "HXhuZ",
                              "name": "DETAILED DESCRIPTION OF THE PREFERRED EMBODIMENT",
                              "fill": "$brand-moss",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "DETAILED DESCRIPTION OF THE PREFERRED EMBODIMENT",
                              "lineHeight": 1.75,
                              "textAlign": "center",
                              "fontFamily": "$font-mono",
                              "fontSize": 8,
                              "fontWeight": "normal",
                              "letterSpacing": 0.9
                            },
                            {
                              "type": "frame",
                              "id": "mKt3g",
                              "name": "[0011]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "PTddx",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0011]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "NY6Ng",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Referring now to FIG. 1, the mark (10) comprises an operator (12) and an agent (22). The back (14) of the operator is substantially flat and inclined not more than fifteen degrees from the horizontal; the head (16) is carried low, its crown falling below the line of the back; and the hands (20) are closed upon the deck (18) within the frontal silhouette. No limb breaks the envelope, any such break being the first detail lost in reduction.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "PiyCg",
                              "name": "[0012]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "hFPHm",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0012]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "XcTPz",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Referring now to FIG. 2, the figures are set in single file and not abreast. Single file presents one frontal area where two would otherwise be presented, and preserves the gap (26) as legible white space at every scale. Set abreast, the gap closes to a seam and the figures merge; set in file, the gap is read as a following distance and the direction of travel is thereby disclosed.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "pS6Mw",
                              "name": "[0013]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "YS2vF",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0013]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "ve3k2",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Referring now to FIG. 3, the wordmark (28) is set upon the ground line (30) and aligned to the leading edge of the agent (22). The mark (10) is not to be reproduced at less than sixteen pixels in height, below which the wake (24) and the gap (26) can no longer be resolved; where a smaller impression is required the agent (22) is to be used alone.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "xeJM0",
                              "name": "[0014]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "k5LVN",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0014]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "ehKM2",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Referring now to FIG. 4, the flow indicia (32) trail the operator (12) and are drawn in the ink of the mark. The design is intended throughout for single-ink reproduction, no element depending upon color, tint, or gradient for its legibility, the whole remaining readable as one solid silhouette upon its ground.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "BfZFr",
                              "name": "[0015]",
                              "width": "fill_container",
                              "gap": 6,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "KRsHH",
                                  "name": "No",
                                  "fill": "$brand-ink-soft",
                                  "textGrowth": "fixed-width",
                                  "width": 34,
                                  "content": "[0015]",
                                  "lineHeight": 1.75,
                                  "fontFamily": "$font-mono",
                                  "fontSize": 8,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "QnNR7",
                                  "name": "Body",
                                  "fill": "$brand-ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "The broken lines in the drawings are shown for the purpose of illustrating environment only and form no part of the claimed design. The ground line (30) and the flow indicia (32) are so shown. All portions appearing in solid line form part of the claimed design as claimed.",
                                  "lineHeight": 1.4,
                                  "textAlign": "justify",
                                  "fontFamily": "$font-body",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "csf18",
              "name": "Sheet 6 · Claims & references cited",
