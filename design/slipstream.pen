                              "fill": "$brand-ink",
                              "content": "HABITAT",
                              "fontFamily": "$font-mono",
                              "fontSize": 10,
                              "fontWeight": "500",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "vX4LH",
                              "name": "Body",
                              "fill": "$brand-ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Editors, terminals, review queues. Resident year-round on dark ground, seasonal on chalk. Rarely seen without a leader; for the solitary form see Plate 4.",
                              "lineHeight": 1.55,
                              "fontFamily": "$font-body",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            }
                          ]
