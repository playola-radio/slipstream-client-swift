            },
            {
              "type": "frame",
              "id": "RL80m",
              "name": "Subhead",
              "width": "fill_container",
              "gap": 48,
              "justifyContent": "space_between",
              "children": [
                {
                  "type": "text",
                  "id": "C7g3yM",
                  "name": "Abstract",
                  "fill": "$brand-ink-soft",
                  "textGrowth": "fixed-width",
                  "width": 1180,
                  "content": "Drafting is a bicycle word before it is anything else, and the peloton is the only culture that has ever drawn a diagram of it. A roadbook does not describe a rider; it describes a rotation — who takes the wind, for how long, and when they swing off. Read that way, the mark stops being a hierarchy. The agent is in front because that is the first relay, not because the operator sits behind it forever.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "n0Rl0",
                  "name": "Lexique",
                  "fill": "$brand-ink-soft",
                  "textGrowth": "fixed-width",
                  "width": 1180,
                  "content": "LEXIQUE, IDENTIQUE SUR CHAQUE PLANCHE\nl'opérateur — the tucked human   ·   l'agent — the leading machine   ·   l'aspiration — the draft\nle relais — the turn at the front   ·   la bordure — the echelon   ·   le trou d'air — the gap that opens\nla flamme rouge — the last kilometre   ·   maillot ink / moss / lime — the three award colours",
                  "lineHeight": 1.7,
                  "fontFamily": "$font-mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
