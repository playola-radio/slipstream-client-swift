# The daemon and Node the app embeds at Contents/Resources/SlipstreamRuntime
# (packaging/build-runtime.sh). The daemon is always the newest @playola-radio/slipstream
# on npm (packaging/latest_daemon.rb); NODE_SHA256 is the darwin-arm64 tar.xz line of
# https://nodejs.org/dist/v<NODE_VERSION>/SHASUMS256.txt.
DAEMON_REPO=playola-radio/slipstream
NODE_VERSION=24.11.0
NODE_SHA256=30bbe12b71f5b89ba44e15dc0cfaf3c733538d46ee375691534b7bbe622225cc
