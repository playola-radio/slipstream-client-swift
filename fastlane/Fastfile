default_platform(:mac)

platform :mac do
  # Bump the version single source (project.yml) and commit, so `release`
  # starts from a clean tree with a never-reused CFBundleVersion.
  #   bundle exec fastlane mac bump                 # build integer only
  #   bundle exec fastlane mac bump version:0.2.0   # + marketing version
  desc "Bump MARKETING_VERSION / integer CURRENT_PROJECT_VERSION, commit"
  lane :bump do |options|
    project_yml = File.expand_path("../project.yml", __dir__)
    text = File.read(project_yml)
    current_build = text[/CURRENT_PROJECT_VERSION:\s*"(\d+)"/, 1]
    UI.user_error!("CURRENT_PROJECT_VERSION (integer) not found in project.yml") unless current_build
    new_build = (current_build.to_i + 1).to_s
    text = text.sub(/CURRENT_PROJECT_VERSION:\s*"\d+"/, %(CURRENT_PROJECT_VERSION: "#{new_build}"))

    if (new_marketing = options[:version])
      UI.user_error!("version must be semver X.Y.Z") unless new_marketing =~ /\A\d+\.\d+\.\d+\z/
      text = text.sub(/MARKETING_VERSION:\s*"[^"]*"/, %(MARKETING_VERSION: "#{new_marketing}"))
    end
    File.write(project_yml, text)
    marketing = text[/MARKETING_VERSION:\s*"([^"]*)"/, 1]

    sh("cd .. && git add project.yml")
    sh(%(cd .. && git commit -m "chore: bump to #{marketing} (#{new_build})"))
    UI.success("Bumped to #{marketing} (#{new_build}). Next: bundle exec fastlane mac release")
  end

  # Runs on merge to main (.github/workflows/release.yml) or locally. Needs the
  # Developer ID identity, notarization credentials (NOTARY_PROFILE, or
  # NOTARY_KEY/NOTARY_KEY_ID/NOTARY_ISSUER), the Sparkle EdDSA key (Keychain account
  # `slipstream-viewer`, or SPARKLE_ED_KEY_FILE), and AWS write access through the
  # AWS CLI's normal credential chain. `sh` runs from fastlane/, hence `cd ..`.
  desc "Build, sign, notarize, DMG, sign appcast, upload to S3, tag"
  lane :release do
    ensure_git_status_clean
    if ENV["NOTARY_PROFILE"].to_s.empty? && ENV["NOTARY_KEY"].to_s.empty?
      UI.user_error!("set NOTARY_PROFILE, or NOTARY_KEY/NOTARY_KEY_ID/NOTARY_ISSUER")
    end
    bucket = ENV.fetch("RELEASE_S3_BUCKET", "playola-static")
    prefix = ENV.fetch("RELEASE_S3_PREFIX", "downloads/SlipstreamViewer")
    host   = ENV.fetch("RELEASE_DOWNLOAD_HOST", "https://playola-static.s3.amazonaws.com")

    # These values are interpolated into shell commands; fail closed on anything
    # outside a safe charset rather than escaping every call site.
    { "RELEASE_S3_BUCKET" => bucket, "RELEASE_S3_PREFIX" => prefix }.each do |k, v|
      UI.user_error!("#{k} has unexpected characters: #{v.inspect}") unless v.match?(%r{\A[A-Za-z0-9._/-]+\z})
    end
    unless host.match?(%r{\Ahttps://[A-Za-z0-9.-]+(?::\d+)?(?:/[A-Za-z0-9._/-]*)?\z})
      UI.user_error!("RELEASE_DOWNLOAD_HOST must be a plain https URL with no shell metacharacters: #{host.inspect}")
    end

    # Fail before building if this version has no release notes.
    release_short = File.read(File.expand_path("../project.yml", __dir__))[/MARKETING_VERSION:\s*"(\d+\.\d+\.\d+)"/, 1]
    UI.user_error!("MARKETING_VERSION not found in project.yml") unless release_short
    notes = "packaging/dist/release-notes-#{release_short}.md"
    sh("cd .. && ruby packaging/release_notes.rb extract CHANGELOG.md '#{release_short}' '#{notes}'")

    sh("cd .. && packaging/build-app.sh")
    sh("cd .. && packaging/sign-app.sh packaging/dist/SlipstreamViewer.app")
    sh("cd .. && packaging/notarize-app.sh packaging/dist/SlipstreamViewer.app")
    sh("cd .. && packaging/make-dmg.sh")

    plist = "packaging/dist/SlipstreamViewer.app/Contents/Info.plist"
    short = sh("cd .. && /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' #{plist}").strip
    build = sh("cd .. && /usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' #{plist}").strip
    UI.user_error!("built version #{short} does not match release notes #{release_short}") unless short == release_short
    name = "SlipstreamViewer-#{short}-#{build}.dmg" # matches make-dmg.sh
    dmg  = "packaging/dist/#{name}"
    url  = "#{host}/#{prefix}/#{name}"

    # build-app.sh pins -derivedDataPath, so sign_update's path is deterministic.
    sign_update = "packaging/build/app/SourcePackages/artifacts/sparkle/Sparkle/bin/sign_update"
    sh("cd .. && test -x '#{sign_update}' || { echo 'sign_update missing at #{sign_update}' >&2; exit 1; }")

    # A rollback removes an item from appcast.xml, but deliberately preserves its
    # immutable DMG. Refuse that existing object so a withdrawn build cannot be
    # published again just because its feed entry is gone.
    sh(<<~SH)
      cd .. && set -euo pipefail
      key="#{prefix}/#{name}"
      if err="$(aws s3api head-object --bucket '#{bucket}' --key "$key" 2>&1 >/dev/null)"; then
        echo "error: release artifact already exists: s3://#{bucket}/$key" >&2
        exit 1
      elif ! printf '%s' "$err" | grep -qiE 'Not Found|404'; then
        echo "error: cannot check existing release artifact (not a confirmed 404), aborting:" >&2
        printf '%s\\n' "$err" >&2; exit 1
      fi
    SH

    # Pull the live appcast first so every prior <item> survives (rollback depends on
    # it). Only a confirmed 404 starts a fresh feed; any other error aborts, so a
    # transient S3 failure can never overwrite the published history.
    sh(<<~SH)
      cd .. && set -euo pipefail
      key="#{prefix}/appcast.xml"
      if err="$(aws s3api head-object --bucket '#{bucket}' --key "$key" 2>&1 >/dev/null)"; then
        aws s3 cp "s3://#{bucket}/$key" packaging/dist/appcast.xml
        echo "fetched existing appcast"
      elif printf '%s' "$err" | grep -qiE 'Not Found|404'; then
        rm -f packaging/dist/appcast.xml
        echo "no existing appcast — first release"
      else
        echo "error: cannot read existing appcast (not a confirmed 404), aborting:" >&2
        printf '%s\\n' "$err" >&2; exit 1
      fi
    SH

    sh("cd .. && ruby packaging/appcast.rb '#{dmg}' '#{url}' '#{sign_update}' '#{notes}'")

    # Keep old DMGs (no --delete). Upload the DMG, the stable website alias, then the
    # appcast last. The alias is a server-side copy; --metadata-directive REPLACE is
    # required or S3 keeps the source metadata and drops no-cache.
    sh("cd .. && aws s3 cp '#{dmg}' 's3://#{bucket}/#{prefix}/'")
    sh("cd .. && aws s3 cp 's3://#{bucket}/#{prefix}/#{name}' 's3://#{bucket}/#{prefix}/SlipstreamViewer-latest.dmg' --metadata-directive REPLACE --content-type application/x-apple-diskimage --cache-control no-cache")
    sh("cd .. && aws s3 cp packaging/dist/appcast.xml 's3://#{bucket}/#{prefix}/appcast.xml' --content-type application/xml --cache-control no-cache")

    # The tag marks the commit as released; CI skips a merge whose tag already exists.
    # Rehearsals to another bucket or prefix must not mark the version as released.
    if bucket == "playola-static" && prefix == "downloads/SlipstreamViewer"
      tag = "v#{short}-b#{build}"
      sh("cd .. && git tag '#{tag}' && git push origin 'refs/tags/#{tag}'")
    else
      UI.important("Rehearsal destination; not tagging the release")
    end

    UI.success("Released #{short} (#{build}): #{host}/#{prefix}/SlipstreamViewer-latest.dmg")
  end
end
